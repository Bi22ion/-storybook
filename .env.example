# Copy to .env for local use. Leave DATABASE_URL blank to use the built-in SQLite database.
DATABASE_URL=
PORT=3000
PGSSL=0
DB=

# Optional AI generation (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=30

# Optional private Supabase Storage uploads (configure all three together)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=

# Production security/deployment settings
HTTPS=0
CORS_ORIGINS=
